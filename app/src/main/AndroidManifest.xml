<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
        Normal (install-time) permission. AOSP AudioService.setMode() and setSpeakerphoneOn() return
        silently without it on every release (checkAudioSettingsPermission), so calls never entered
        MODE_IN_COMMUNICATION and Android 10/11 could not switch speaker/earpiece.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Experimental lock-screen call alert only (test_call_lock_screen, off by default); never requested otherwise. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!--
        Fine location: Bluetooth scanning on Android 10-11, and the experimental "Share app nearby"
        Wi-Fi Direct group on Android 10-12 (requested only by OfflineAppShareActivity on 12-12L).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <!-- Android 12-12L: a fine-location request is ignored unless coarse location is requested with it (OfflineAppShareActivity). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <!--
        Experimental "Share app nearby" only (test_offline_app_share, off by default): a Wi-Fi Direct
        group (CHANGE_WIFI_STATE; NEARBY_WIFI_DEVICES on Android 13+, never used to derive location)
        and a local HTTP server on that group's address (INTERNET is required for any IP socket; the
        app still makes no internet connection). NEARBY_WIFI_DEVICES is requested only by that screen.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <!--
        Wi-Fi Aware carrier (default off, Settings "Use Wi-Fi for faster connections"): ConnectivityManager.requestNetwork
        for a Wi-Fi Aware data path needs this normal (install-time) permission; without it requestNetwork throws
        SecurityException. Not used by anything else; ACCESS_NETWORK_STATE is the companion permission ConnectivityManager
        callbacks expect (PlatformBehaviourGuardTest).
    -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Audio-only live (Design AL): background listening runs under a media-playback foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
        Android 10-11 only in use (design decision Q37): the session service adds the location type so background Bluetooth scan
        results are delivered there. The permission exists from Android 14 and is never exercised there. No background-location
        permission is requested. A Play build needs the location foreground-service declaration (demo video).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!--
        Onboarding / Settings offer the system's one-tap "always run in the background" prompt (design decision Q38). It only opens
        Android's own dialog; nothing changes without the user's tap. Check Play review risk before any Play build keeps it.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
        Experimental, off by default (Q-N2, BootResume): the receiver below is disabled in this manifest and is enabled only
        while the user's opt-in is on, so nothing runs at boot on a default install.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.aware" android:required="false" />
    <!--
        Background reliability (BackgroundPolicy, diagnostics only): see whether a phone maker's
        documented background killer is installed (Don't Kill My App). Package visibility (API 30+)
        hides other packages unless named here; nothing is launched or changed.
    -->
    <queries>
        <!-- The battery-optimisation prompt and list screens (Android 11+ hides which activity can handle an implicit intent). -->
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
        <package android:name="com.huawei.powergenie" />
        <package android:name="com.huawei.android.hwaps" />
        <package android:name="com.mediatek.duraspeed" />
        <package android:name="com.pri.screenoff.killer" />
        <package android:name="com.motorola.batterycare" />
        <package android:name="com.evenwell.powersaving.g3" />
        <package android:name="com.evenwell.emm" />
        <!-- Phone-maker killer and system-Bluetooth packages read for guidance (BackgroundOem, DeviceTraitsProbe). -->
        <package android:name="com.hihonor.powergenie" />
        <package android:name="com.transsion.phonemaster" />
        <package android:name="com.hihonor.bluetooth" />
        <package android:name="com.android.bluetooth" />
        <package android:name="com.google.android.bluetooth" />
    </queries>

    <application
        android:name=".MeshLiveApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bluetoothtest">
        <!--
            Android 16 (targetSdk 36) ignores screenOrientation, resizeableActivity and aspect-ratio limits on screens at least
            600dp wide (tablets, unfolded foldables, Chromebooks), so a portrait-only phone app would rotate there and every
            activity except MainActivity (which handles its own configuration changes) would be recreated, losing a scan or a
            half-filled dialog. This documented opt-out keeps the portrait letterboxed behaviour; it is removed for
            targetSdk 37, so layouts must be made adaptive before that bump (PlatformBehaviourGuardTest).
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|keyboard|keyboardHidden|navigation|locale|layoutDirection"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Next-launch crash report prompt (CrashReports); started by MainActivity only for a plain user launch. -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- First-run explanation; started by MainActivity only for a plain user launch. -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".VerifyContactActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".BlockedPeopleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- QR scanner (zxing-android-embedded): portrait like the rest of the app. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />
        <!-- The scanner the app opens: zxing's activity with its prompt kept above the system bars (Android 15+). -->
        <activity
            android:name=".ScannerCaptureActivity"
            android:clearTaskOnLaunch="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!-- Experimental store-and-forward messages (off by default); opened only from MainActivity. -->
        <activity
            android:name=".WipeIncompleteActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait" />
        <!-- Experimental "Share app nearby" (off by default); opened only from MainActivity. -->
        <activity
            android:name=".OfflineAppShareActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MessagesActivity"
            android:exported="false"
            android:label="Messages"
            android:screenOrientation="portrait" />
        <!-- "Stop now" of the Visible-by-name notification; not exported. -->
        <receiver
            android:name=".NameWindowStopReceiver"
            android:exported="false" />
        <!-- Messaging v2 (experimental, test_messaging_v2): "Mark as read" of a conversation notification. Not exported; the
             PendingIntent is immutable and explicit. -->
        <receiver
            android:name=".MessageNotificationReceiver"
            android:exported="false" />
        <service
            android:name=".ActiveVideoSessionService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|connectedDevice|mediaPlayback|location" />
        <!--
            Experimental boot resume (BootResume, default off): disabled until the user opts in; starts only the connectedDevice
            service. QUICKBOOT_POWERON is the phone makers' fast-boot broadcast. Not exported: the system sends these by
            package.
        -->
        <receiver
            android:name=".BootResumeReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!--
            Offline app sharing (AppShare): not exported; grants a temporary read of one copied APK in
            cache/app-share/ to the share target the user picks. Nothing else is exposed.
        -->
        <provider
            android:name=".AppShareFileProvider"
            android:authorities="${applicationId}.appshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/app_share_paths" />
        </provider>
        <!--
            Messaging v2 phase 1b (experimental, master switch test_messaging_v2): "Open" of a received file. Not exported; an
            app gets a one-file read grant for a random-token URI and every byte is decrypted on demand from the file vault
            (openProxyFileDescriptor), so no plaintext file exists. Grants end when the thread is left or after 5 minutes.
        -->
        <provider
            android:name=".MessagingV2OpenProvider"
            android:authorities="${applicationId}.v2open"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!--
            Messaging v2 phase 1b: tap-to-decode of a received picture in an isolated process (own uid, no permissions, no
            access to our files), destroyed after the decode. No picture is ever decoded without a tap.
        -->
        <service
            android:name=".MessagingV2ImageService"
            android:exported="false"
            android:isolatedProcess="true" />
        <!-- DEBUG-only harness for the attachment pipeline until the conversation UI (phase 1c) exists; finishes at once in a release build. -->
        <activity
            android:name=".MessagingV2AttachActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
